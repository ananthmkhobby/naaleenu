{
  "name": "@breakfast/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": ".venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "test": ".venv/bin/python -m pytest",
    "lint": ".venv/bin/python -m compileall app tests",
    "db:migrate": ".venv/bin/python -m app.cli migrate",
    "seed": ".venv/bin/python -m app.cli seed",
    "smoke": ".venv/bin/python -m app.cli smoke"
  }
}
